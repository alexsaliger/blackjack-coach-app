{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "C:\\src\\flutter\\bin\\flutter.bat",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port=8085",
        "--web-hostname=127.0.0.1"
      ],
      "port": 8085
    },
    {
      "name": "web-static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8086",
        "--directory",
        "build/web"
      ],
      "port": 8086
    },
    {
      "name": "web2",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8087",
        "--directory",
        "build/web"
      ],
      "port": 8087
    }
  ]
}
